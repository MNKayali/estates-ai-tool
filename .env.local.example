# ── Core ─────────────────────────────────────────────────────────────────────
AI_API_KEY=your-anthropic-api-key-here
ACCESS_CODE=your-access-code-here

# ── Data files (GitHub raw URLs) ─────────────────────────────────────────────
RATES_FILE_URL=https://raw.githubusercontent.com/MNKayali/estates-ai-tool/main/NRM1_Cost_Estimate_Tool_v3_3.xlsx
PROGRAMME_FILE_URL=https://raw.githubusercontent.com/MNKayali/estates-ai-tool/main/Estates_AI_Programme_v4_0.xlsx
TEMPLATE_FILE_URL=https://raw.githubusercontent.com/MNKayali/estates-ai-tool/main/Estates_AI_Report_Template.docx

# ── Vercel KV (Upstash Redis — set automatically by Vercel integration) ───────
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
# KV_URL=

# ── Sentry error tracking (optional — errors are silently dropped if absent) ──
# 1. Create a project at https://sentry.io  →  Next.js
# 2. Copy the DSN from Settings > Projects > [your project] > Client Keys
# 3. Add NEXT_PUBLIC_SENTRY_DSN to Vercel Environment Variables
# 4. For source-map uploads (better stack traces in production), also add:
#    SENTRY_AUTH_TOKEN  — from https://sentry.io/settings/account/api/auth-tokens/
#    SENTRY_ORG         — your Sentry organisation slug
#    SENTRY_PROJECT     — your Sentry project slug (default: estates-ai-tool)
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=estates-ai-tool
