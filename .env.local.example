# Copy to .env.local for local development. Production values live in the
# Vercel project settings. Never commit real values. See README / CLAUDE.md.

# ── Core ─────────────────────────────────────────────────────────────────────
AI_API_KEY=your-anthropic-api-key-here

# ── Workbooks (a URL, or a local path in development) ────────────────────────
# The filenames are kept on purpose; the NRM1 file holds v5.x content.
RATES_FILE_URL=https://raw.githubusercontent.com/MNKayali/estates-ai-tool/main/NRM1_Cost_Estimate_Tool_v5_2.xlsx
PROGRAMME_FILE_URL=https://raw.githubusercontent.com/MNKayali/estates-ai-tool/main/Estates_AI_Programme_v4_3.xlsx
# Procurement Reference (route / commercial model / route to market / contract)
PROCUREMENT_FILE_URL=https://raw.githubusercontent.com/MNKayali/estates-ai-tool/main/Projento_Procurement_Reference.xlsx

# ── Accounts and admin (both REQUIRED in production — they fail closed) ──────
# COOKIE_SECRET signs the session, free-trial and admin cookies: openssl rand -hex 32
COOKIE_SECRET=
ADMIN_CODE=
# Origin used in set-password links
APP_ORIGIN=https://www.projento.co.uk

# ── Email (optional — without it the admin copies each link by hand) ─────────
# RESEND_API_KEY=
# EMAIL_FROM=

# ── Vercel KV (Upstash Redis — set automatically by the Vercel integration) ──
# Accounts, reports, free-trial counts and rate limits. Locally, use
# `node scripts/dev-kv.mjs` (in-memory) or `node scripts/dev-open.mjs` (no sign-in).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
# KV_URL=

# ── Sentry error tracking (optional — errors are silently dropped if absent) ──
# 1. Create a project at https://sentry.io  →  Next.js
# 2. Copy the DSN from Settings > Projects > [your project] > Client Keys
# 3. Add NEXT_PUBLIC_SENTRY_DSN to Vercel Environment Variables
# 4. For source-map uploads (better stack traces in production), also add:
#    SENTRY_AUTH_TOKEN  — from https://sentry.io/settings/account/api/auth-tokens/
#    SENTRY_ORG         — your Sentry organisation slug
#    SENTRY_PROJECT     — your Sentry project slug (default: estates-ai-tool)
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=estates-ai-tool
